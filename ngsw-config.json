{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    },
    {
      "name": "fonts",
      "installMode": "lazy",
      "updateMode": "prefetch", 
      "resources": {
        "urls": [
          "https://fonts.googleapis.com/**",
          "https://fonts.gstatic.com/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "timesheet-api",
      "urls": [
        "https://your-api-domain.com/api/daily/by-date/**",
        "https://your-api-domain.com/api/*/monthly/by-date/**",
        "https://your-api-domain.com/api/*/weekly/by-date/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "1h",
        "timeout": "10s"
      }
    },
    {
      "name": "user-data",
      "urls": [
        "https://your-api-domain.com/api/users/**",
        "https://your-api-domain.com/api/auth/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 20,
        "maxAge": "30m",
        "timeout": "5s"
      }
    },
    {
      "name": "static-data",
      "urls": [
        "https://your-api-domain.com/api/health",
        "https://your-api-domain.com/api/export/**",
        "https://your-api-domain.com/api/admin/**",
        "https://your-api-domain.com/api/bulk/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 50,
        "maxAge": "1d"
      }
    }
  ]
}
