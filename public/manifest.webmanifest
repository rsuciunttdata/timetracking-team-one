{
  "id": "timesheet-tracker-pwa",
  "name": "Timesheet Tracker - Professional Time Management",
  "short_name": "Timesheet",
  "description": "Professional time tracking and timesheet management application with offline support, validation workflows, and comprehensive reporting.",
  "version": "1.0.0",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "scope": "/",
  "start_url": "/?utm_source=pwa&utm_medium=homescreen&utm_campaign=install",
  "theme_color": "#2563eb",
  "background_color": "#ffffff",
  "edge_side_panel": {
    "preferred_width": 400
  },
  "categories": ["productivity", "business", "utilities", "lifestyle"],
  "lang": "en-US",
  "dir": "ltr",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "handle_links": "preferred",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://timesheet-tracker.app/manifest.webmanifest"
    }
  ],
  "icons": [
    {
      "src": "icons/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "icons/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
